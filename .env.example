# Kopiere diese Datei nach .env und trag deine Werte ein.

# DeepSeek-API-Schlüssel von platform.deepseek.com (bleibt nur auf dem Server)
DEEPSEEK_API_KEY=
# Modell, z. B. deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Der Server lauscht nur lokal; nach außen geht es über Caddy mit HTTPS (siehe ANLEITUNG.md)
PORT=3000
HOST=127.0.0.1

# Wo Einheiten, Mitschriften und Dateien liegen
DATA_DIR=data

# Wie lange eine Anmeldung gilt (Tage)
SESSION_DAYS=30

NODE_ENV=production
